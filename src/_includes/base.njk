<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#17283c">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} · RSS" href="{{ '/feed.xml' | absoluteUrl(site.url) }}">
  {% if not noindex %}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if contentType %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:image" content="{{ (cover or '/images/header.webp') | absoluteUrl(site.url) }}">
  <meta property="og:image:alt" content="{{ coverAlt or site.description }}">
  <meta name="twitter:card" content="summary_large_image">
  {% if contentType %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
  {% endif %}
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <link rel="stylesheet" href="{% if noindex %}/styles/style.css{% else %}{{ '/styles/style.css' | relativeUrl(page.url) }}{% endif %}">
  <link rel="icon" href="{% if noindex %}/images/favicon.png{% else %}{{ '/images/favicon.png' | relativeUrl(page.url) }}{% endif %}" type="image/png" sizes="32x32">
  {% if search %}<script src="{{ '/scripts/search.js' | relativeUrl(page.url) }}" defer></script>{% endif %}
  {% if travelMap %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <link rel="stylesheet" href="{{ '/styles/vendor/MarkerCluster-1.5.3.css' | relativeUrl(page.url) }}">
  <link rel="stylesheet" href="{{ '/styles/travel.css?v=clusters-2' | relativeUrl(page.url) }}">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
  <script src="{{ '/scripts/vendor/leaflet.markercluster-1.5.3.js' | relativeUrl(page.url) }}" defer></script>
  <script src="{{ '/scripts/travel-countries.js' | relativeUrl(page.url) }}" defer></script>
  <script src="{{ '/scripts/travel.js?v=clusters-1' | relativeUrl(page.url) }}" defer></script>
  {% endif %}
  {% if videoLibrary or contentType == 'video' %}
  <link rel="stylesheet" href="{{ '/styles/video.css' | relativeUrl(page.url) }}">
  <script src="{{ '/scripts/video.js' | relativeUrl(page.url) }}" defer></script>
  {% endif %}
</head>
<body{% if travelMap %} class="travel-page"{% elif videoLibrary %} class="video-library-page"{% endif %}>
  <a class="skip-link" href="#main">跳到正文</a>
  <header class="header">
    <nav class="topnav" aria-label="主导航">
      {% for item in site.navigation %}<a href="{% if noindex %}{{ item.url }}{% else %}{{ item.url | relativeUrl(page.url) }}{% endif %}"{% if navKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
    </nav>
    <div class="header-content">{% if contentType %}<p class="header-title">{{ heading }}</p>{% else %}<h1>{{ heading or site.title }}</h1>{% endif %}<p>{{ subtitle or site.tagline }}</p></div>
  </header>
  <main id="main" class="{% if wide %}single-column{% else %}row{% endif %}" tabindex="-1">
    <div class="leftcolumn">{{ content | safe }}</div>
    {% if not wide %}{% include 'sidebar.njk' %}{% endif %}
  </main>
  <footer class="footer"><p>© {{ site.startYear }}–{{ '' | year }} <a href="{% if noindex %}/index.html{% else %}{{ '/index.html' | relativeUrl(page.url) }}{% endif %}">{{ site.title }}</a> · 一起记录</p><a href="{% if noindex %}/page.html{% else %}{{ '/page.html' | relativeUrl(page.url) }}{% endif %}">浏览文章</a><a href="{% if noindex %}/archive.html{% else %}{{ '/archive.html' | relativeUrl(page.url) }}{% endif %}">年度归档</a><a href="{% if noindex %}/feed.xml{% else %}{{ '/feed.xml' | relativeUrl(page.url) }}{% endif %}">RSS 订阅</a></footer>
</body>
</html>
