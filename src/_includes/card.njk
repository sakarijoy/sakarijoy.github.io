<article class="card post-card"{% if search %} data-search-card data-search-text="{{ entry.data.title }} {{ entry.data.description }} {{ entry.data.category }} {{ entry.data.author }}"{% endif %}>
  {% if entry.data.cover %}<a class="cover-link" href="{{ entry.url | relativeUrl(page.url) }}" aria-label="阅读：{{ entry.data.title }}"><img class="post-cover" style="--cover-ratio: {{ entry.data.coverWidth }} / {{ entry.data.coverHeight }}" src="{{ entry.data.cover | relativeUrl(page.url) }}" alt="{{ entry.data.coverAlt }}" width="{{ entry.data.coverWidth }}" height="{{ entry.data.coverHeight }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}></a>{% endif %}
  <div class="post-meta"><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time><span>{{ entry.data.category }}</span><span>{{ entry.data.author }}</span></div>
  <h2><a href="{{ entry.url | relativeUrl(page.url) }}">{{ entry.data.title }}</a></h2><p>{{ entry.data.description }}</p>
  <a class="text-link" href="{{ entry.url | relativeUrl(page.url) }}">{% if entry.data.contentType == 'video' %}观看与阅读{% else %}阅读全文{% endif %} →</a>
</article>
