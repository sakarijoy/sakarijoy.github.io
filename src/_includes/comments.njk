{% if commentService.enabled and comments != false %}
<section class="card comments-section" id="comments" aria-labelledby="comments-title"{% if commentService.envId %} data-comments data-env-id="{{ commentService.envId }}" data-comment-path="{{ commentId or page.url }}" data-client-version="{{ commentService.clientVersion }}"{% endif %}>
  <div class="comments-heading"><span class="eyebrow">把故事接着聊下去</span><h2 id="comments-title">留言与回应</h2></div>
  {% if commentService.envId %}
  <p class="comments-intro">欢迎分享你的感受，无需注册账号。请勿在留言中填写手机号、住址等私人信息。</p>
  <p class="comments-status" data-comments-status role="status">正在加载评论…</p>
  <div id="twikoo-comments" data-comments-container></div>
  <button class="comments-retry" type="button" data-comments-retry hidden>重新加载评论</button>
  <noscript><p class="comments-status">请开启浏览器的 JavaScript 后查看和发表留言。</p></noscript>
  <script src="{{ '/scripts/comments.js' | relativeUrl(page.url) }}" defer></script>
  {% else %}
  <p class="comments-status">评论区正在准备中，期待很快在这里和你交流。</p>
  {% endif %}
</section>
{% endif %}
