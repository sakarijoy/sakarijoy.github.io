---
layout: base.njk
---
<article class="card prose article-detail">
  <nav class="breadcrumb" aria-label="面包屑"><a href="{{ '/index.html' | relativeUrl(page.url) }}">首页</a><span>/</span><a href="{{ listingUrl | relativeUrl(page.url) }}">{{ listingLabel }}</a><span>/</span><span aria-current="page">{{ category }}</span></nav>
  <h1 class="article-title">{{ title }}</h1><div class="post-meta">{% if visitDateUnknown %}<span>旅行日期待补充</span>{% else %}<time datetime="{{ date | isoDate }}">{{ date | displayDate }}</time>{% endif %}<span>{{ category }}</span><span>{{ author }}</span></div>
  {% if contentType == 'video' %}{% include 'video-player.njk' %}{% endif %}
  <div class="article-body">{{ content | safe }}</div>
  <div class="article-end"><a class="text-link" href="{{ listingUrl | relativeUrl(page.url) }}">← 返回{{ listingLabel }}列表</a><a class="text-link" href="{{ '/index.html' | relativeUrl(page.url) }}">回到首页 ↑</a></div>
</article>
{% include 'comments.njk' %}
