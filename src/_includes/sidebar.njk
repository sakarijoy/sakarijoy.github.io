<aside class="rightcolumn" aria-label="博客信息">
  <section class="card profile">
    <div class="couple-avatars" role="group" aria-label="两位记录者的头像">
      {% for owner in site.owners | take(2) %}
      <img class="couple-avatar" src="{{ owner.avatar | relativeUrl(page.url) }}" alt="{{ owner.avatarAlt }}" width="96" height="96" loading="lazy">
      {% if not loop.last %}<span class="couple-connection" role="img" aria-label="心意相连"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-8.5-5.3-8.5-11.4a4.8 4.8 0 0 1 8.5-3.1 4.8 4.8 0 0 1 8.5 3.1C20.5 15.7 12 21 12 21Z"/></svg></span>{% endif %}
      {% endfor %}
    </div>
    <h2>一起记录</h2><p>{{ site.description }}</p><a class="text-link" href="{{ '/about.html' | relativeUrl(page.url) }}">关于我们 →</a>
  </section>
  <section class="card"><h2 class="small-heading">最近更新</h2>
    {% for entry in collections.published | take(3) %}<a class="recent-post" href="{{ entry.url | relativeUrl(page.url) }}">{{ entry.data.title }}<span>{{ entry.date | isoDate }} · {{ entry.data.category }}</span></a>{% else %}<p>新的记录正在准备。</p>{% endfor %}
  </section>
  <section class="card"><h2 class="small-heading">记录归档</h2><ul class="archive-links"><li><a href="{{ '/page.html' | relativeUrl(page.url) }}">文章<span>{{ collections.posts.length }}</span></a></li><li><a href="{{ '/video.html' | relativeUrl(page.url) }}">视频<span>{{ collections.videos.length }}</span></a></li><li><a href="{{ '/travel.html' | relativeUrl(page.url) }}">旅行<span>{{ collections.travel.length }}</span></a></li></ul></section>
</aside>
