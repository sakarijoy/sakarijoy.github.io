---
layout: false
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ site.title }}</title>
<link>{{ '/index.html' | absoluteUrl(site.url) }}</link>
<description>{{ site.description }}</description>
<language>zh-CN</language>
<atom:link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml" />
{% for item in collections.published | take(30) %}
<item>
<title>{{ item.data.title }}</title>
<link>{{ item.url | absoluteUrl(site.url) }}</link>
<guid isPermaLink="true">{{ item.url | absoluteUrl(site.url) }}</guid>
<description>{{ item.data.description }}</description>
<category>{{ item.data.category }}</category>
<pubDate>{{ item.date | rssDate }}</pubDate>
</item>
{% endfor %}</channel>
</rss>
